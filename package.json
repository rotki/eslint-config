{
  "name": "@rotki/eslint-config",
  "version": "7.0.0",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/rotki/eslint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rotki/eslint-config.git"
  },
  "author": "Rotki Solutions GmbH <info@rotki.com>",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "scripts": {
    "build": "pnpm run gen && tsdown --clean --dts",
    "stub": "tsdown",
    "dev": "tsdown --watch & npx @eslint/config-inspector --config eslint.config.ts",
    "watch": "tsdown --watch",
    "lint": "eslint .",
    "prepack": "pnpm run build",
    "release": "bumpp -r --no-push",
    "prepare": "husky",
    "gen": "tsx scripts/typegen.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.2.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@rotki/eslint-plugin": ">=1.5.0",
    "eslint": "^9.20.0 || ^10.0.0",
    "eslint-plugin-storybook": ">=10.2.14",
    "eslint-plugin-tsdoc": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "@intlify/eslint-plugin-vue-i18n": {
      "optional": true
    },
    "@prettier/plugin-xml": {
      "optional": true
    },
    "@rotki/eslint-plugin": {
      "optional": true
    },
    "eslint-plugin-storybook": {
      "optional": true
    },
    "eslint-plugin-tsdoc": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/install-pkg": "2.0.1",
    "@clack/prompts": "1.7.0",
    "@e18e/eslint-plugin": "0.8.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/markdown": "8.0.3",
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint-config-flat-gitignore": "2.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-flat-config-utils": "3.2.0",
    "eslint-merge-processors": "2.0.0",
    "eslint-plugin-antfu": "3.2.3",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-html": "8.2.0",
    "eslint-plugin-import-lite": "0.6.0",
    "eslint-plugin-jsdoc": "64.3.2",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-pnpm": "1.8.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-regexp": "3.2.0",
    "eslint-plugin-unicorn": "74.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-vue": "10.10.0",
    "eslint-plugin-yml": "3.8.1",
    "eslint-processor-vue-blocks": "2.0.0",
    "find-up-simple": "1.0.1",
    "globals": "17.11.0",
    "local-pkg": "1.2.1",
    "prettier": "3.9.6",
    "vue-eslint-parser": "10.4.1",
    "yaml-eslint-parser": "2.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/config-inspector": "3.3.0",
    "@rotki/eslint-config": "workspace:*",
    "@rotki/eslint-plugin": "1.5.1",
    "@types/node": "24.13.3",
    "@types/prompts": "2.4.9",
    "bumpp": "12.2.2",
    "eslint": "10.9.1",
    "eslint-plugin-tsdoc": "0.5.2",
    "eslint-typegen": "2.3.1",
    "execa": "10.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "rimraf": "6.1.3",
    "tinyglobby": "0.2.17",
    "tsdown": "0.22.14",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
